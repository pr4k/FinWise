# Loaded by ./run.sh. Shell KEY=value syntax; quote values containing spaces.
# Local HTTP development only. Production HTTPS must use secure cookies.
FINWISE_BIND=127.0.0.1:3000
FINWISE_DATA_DIR=data
FINWISE_WEB_DIR=web
FINWISE_INSECURE_LOCAL_COOKIES=true
FINWISE_UPLOAD_FILE_MAX_BYTES=8388608
# Optional database override (otherwise stored inside FINWISE_DATA_DIR):
# DATABASE_URL=sqlite://data/finwise.sqlite
# Optional: FINWISE_RELEASE=true ./run.sh for an optimized build.
