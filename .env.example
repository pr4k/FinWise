# Loaded by ./run.sh. Shell KEY=value syntax; quote values containing spaces.
# Local HTTP defaults for ./run.sh. Docker Compose also serves HTTP on port
# 3000 by default for a trusted LAN or Tailscale deployment.
FINWISE_BIND=127.0.0.1:3000
FINWISE_DATA_DIR=data
FINWISE_WEB_DIR=web
FINWISE_INSECURE_LOCAL_COOKIES=true
FINWISE_UPLOAD_FILE_MAX_BYTES=8388608
# Docker Compose publishes on all NAS interfaces by default. Set this to the
# NAS Tailscale IP to limit access to that interface when Tailscale runs on
# TrueNAS; use the LAN IP if reaching TrueNAS through a subnet router.
# FINWISE_PUBLISH_IP=100.x.y.z
# FINWISE_PUBLISH_PORT=3000
# Docker Compose allows HTTP sign-in by default. Set false behind an HTTPS proxy.
# FINWISE_ALLOW_INSECURE_HTTP=false
# Optional database override (otherwise stored inside FINWISE_DATA_DIR):
# DATABASE_URL=sqlite://data/finwise.sqlite
# Optional: FINWISE_RELEASE=true ./run.sh for an optimized build.
